# GROQ_API_KEY: Required for Groq AI API calls (exclusive provider for AI Tutor).
# Users configure this via their environment or secrets.
GROQ_API_KEY="your_groq_api_key_here"

# GROQ_MODEL: Optional text generation model ID (defaults to openai/gpt-oss-120b).
# Currently recommended supported models: openai/gpt-oss-120b, openai/gpt-oss-20b
GROQ_MODEL="openai/gpt-oss-120b"

# AUTH_SESSION_SECRET: Server-only HMAC signing secret for user session tokens (REQUIRED in production).
# Must be at least 32 characters and non-placeholder; if omitted in local dev, an ephemeral random secret is generated per boot.
AUTH_SESSION_SECRET="replace_with_a_long_random_server_secret"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for trusted origin validation, self-referential links, and API endpoints.
APP_URL="MY_APP_URL"

# TRUSTED_ORIGINS: Optional comma-separated allowlist of trusted browser origins for CSRF/Origin validation.
# Example: "https://academy.example.com,http://localhost:3000"
TRUSTED_ORIGINS=""

# TRUST_PROXY: Set to "1" when deployed behind a trusted HTTPS reverse proxy (e.g. Cloud Run / nginx)
# so Express honors proxy-verified client IP and HTTPS protocol headers safely.
TRUST_PROXY="1"

# PORT: Application HTTP listen port (defaults to 3000; avoids colliding with NGINX_PORT if inherited).
PORT="3000"

# CFA_TRUSTED_PREVIEW: Explicit override ("true" or "false") for Google AI Studio iframe framing.
# When omitted, trusted preview framing activates ONLY in verified AI Studio managed preview containers;
# standalone deployments enforce strict frame-ancestors 'self' + X-Frame-Options: SAMEORIGIN.
# CFA_TRUSTED_PREVIEW="false"

# CSP_FRAME_ANCESTORS: Optional explicit https:// space-separated allowlist for CSP frame-ancestors.
# CSP_FRAME_ANCESTORS=""

